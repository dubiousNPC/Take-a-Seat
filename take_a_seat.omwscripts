# Take a Seat -- sit on furniture
#
# SharedRay is bundled and version-guards itself, so if another mod ships a
# newer copy only that one runs.
PLAYER: scripts/SharedRay/SharedRay_v2.lua

# AnimRefresh is NO LONGER BUNDLED -- see docs/animrefresh.md. It is what
# re-issues the sit pose after the engine rebuilds the player's model (a
# first/third person switch, Rest, Travel, a game load). Without it the pose is
# simply lost on those events, so any mod in the load order that ships
# AnimRefresh_v5.lua supplies it (CAKE, DED, WhyWalk all do). The player script
# logs once if nothing did, rather than failing quietly.

PLAYER: scripts/take_a_seat/take_a_seat.lua
GLOBAL: scripts/take_a_seat/take_a_seat_global.lua
