# Take a Seat -- sit on furniture
#
# SharedRay is bundled and version-guards itself, so if another mod ships a
# newer copy only that one runs.
PLAYER: scripts/SharedRay/SharedRay_v2.lua

# AnimRefresh is bundled again, and it needs this line: a script file that is
# not registered here is shipped and never loaded, so the sit pose would still
# be dropped on every perspective change, Rest, Travel and game load with the
# file sitting right there. It version-guards itself, so if another mod ships a
# newer copy only that one runs.
PLAYER: scripts/AnimRefresh/AnimRefresh_v6.lua

PLAYER: scripts/take_a_seat/take_a_seat.lua
GLOBAL: scripts/take_a_seat/take_a_seat_global.lua
